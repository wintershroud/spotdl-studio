{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spotDL Studio",
  "version": "0.2.0",
  "identifier": "io.github.wintershroud.spotdl-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "spotDL Studio",
        "width": 960,
        "height": 760,
        "minWidth": 680,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Download Spotify tracks, albums and playlists with spotDL",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
